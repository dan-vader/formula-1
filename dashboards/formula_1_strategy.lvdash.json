{
  "datasets": [
    {
      "name": "89198b57",
      "displayName": "race_results",
      "queryLines": [
        "SELECT\n",
        "  s.season,\n",
        "  s.round,\n",
        "  s.event_name,\n",
        "  s.circuit_name,\n",
        "  s.session_type,\n",
        "  s.regulation_era,\n",
        "  d.full_name        AS driver,\n",
        "  d.name_acronym     AS driver_code,\n",
        "  t.team_name,\n",
        "  t.team_colour,\n",
        "  t.power_unit_supplier,\n",
        "  fs.status,\n",
        "  fs.status_category,\n",
        "  CASE WHEN fs.status_category = 'Retired' THEN 1 ELSE 0 END AS is_retired,\n",
        "  rc.grid_position,\n",
        "  rc.classified_position,\n",
        "  rc.grid_position - rc.classified_position AS positions_gained,\n",
        "  ABS(rc.grid_position - rc.classified_position) AS positions_changed,\n",
        "  rc.points,\n",
        "  rc.overtakes_made\n",
        "FROM v_race_classification_current rc\n",
        "JOIN dim_session s        ON rc.session_sk = s.session_sk\n",
        "JOIN dim_driver d         ON rc.driver_sk = d.driver_sk\n",
        "JOIN dim_team t           ON rc.team_sk = t.team_sk\n",
        "JOIN dim_finish_status fs ON rc.finish_status_sk = fs.finish_status_sk"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "formula_1_gold"
    },
    {
      "name": "45546fb3",
      "displayName": "q1_circuit_extremes",
      "queryLines": [
        "WITH by_circuit AS (\n",
        "  SELECT\n",
        "    s.circuit_name,\n",
        "    COUNT(DISTINCT s.season) AS races,\n",
        "    ROUND(AVG(ABS(rc.grid_position - rc.classified_position)), 2) AS avg_positions_changed\n",
        "  FROM v_race_classification_current rc\n",
        "  JOIN dim_session s ON rc.session_sk = s.session_sk\n",
        "  WHERE s.session_type = 'Race'\n",
        "    AND rc.grid_position IS NOT NULL\n",
        "    AND rc.classified_position IS NOT NULL\n",
        "  GROUP BY s.circuit_name\n",
        "  HAVING COUNT(DISTINCT s.season) >= 2\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT *,\n",
        "    ROW_NUMBER() OVER (ORDER BY avg_positions_changed ASC)  AS rank_low,\n",
        "    ROW_NUMBER() OVER (ORDER BY avg_positions_changed DESC) AS rank_high\n",
        "  FROM by_circuit\n",
        ")\n",
        "SELECT\n",
        "  circuit_name,\n",
        "  races,\n",
        "  avg_positions_changed,\n",
        "  CASE WHEN rank_low <= 5 THEN 'Qualifying decides' ELSE 'Race reshuffles' END AS circuit_group\n",
        "FROM ranked\n",
        "WHERE rank_low <= 5 OR rank_high <= 5"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "formula_1_gold"
    },
    {
      "name": "1075a47f",
      "displayName": "pit_stops",
      "queryLines": [
        "SELECT\n",
        "  s.season,\n",
        "  s.circuit_name,\n",
        "  s.session_type,\n",
        "  t.team_name,\n",
        "  d.full_name                    AS driver,\n",
        "  ts.track_status_name,\n",
        "  ts.is_neutralised,\n",
        "  f.is_tyre_change,\n",
        "  f.is_penalty_served,\n",
        "  p.lap_number,\n",
        "  p.pit_lane_duration_ms / 1000.0 AS pit_lane_sec,\n",
        "  p.stop_duration_ms / 1000.0     AS stop_sec,\n",
        "  p.positions_lost\n",
        "FROM fact_transaction_pit_stop p\n",
        "JOIN dim_session s         ON p.session_sk = s.session_sk\n",
        "JOIN dim_team t            ON p.team_sk = t.team_sk\n",
        "JOIN dim_driver d          ON p.driver_sk = d.driver_sk\n",
        "JOIN dim_track_status ts   ON p.track_status_sk = ts.track_status_sk\n",
        "JOIN dim_pit_stop_flags f  ON p.pit_stop_flags_sk = f.pit_stop_flags_sk"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "formula_1_gold"
    },
    {
      "name": "380b274f",
      "displayName": "safety_car_by_race",
      "queryLines": [
        "SELECT\n",
        "  s.season,\n",
        "  s.circuit_name,\n",
        "  s.session_type,\n",
        "  s.event_name,\n",
        "  MAX(CASE WHEN ts.is_neutralised THEN 1 ELSE 0 END) AS had_safety_car\n",
        "FROM fact_transaction_lap l\n",
        "JOIN dim_session s       ON l.session_sk = s.session_sk\n",
        "JOIN dim_track_status ts ON l.track_status_sk = ts.track_status_sk\n",
        "GROUP BY s.season, s.circuit_name, s.session_type, s.event_name"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "formula_1_gold"
    },
    {
      "name": "7402d2ae",
      "displayName": "tyre_stints",
      "queryLines": [
        "SELECT\n",
        "  s.season,\n",
        "  s.circuit_name,\n",
        "  s.session_type,\n",
        "  t.team_name,\n",
        "  d.full_name      AS driver,\n",
        "  tc.compound_name,\n",
        "  tc.hardness_rank,\n",
        "  l.stint_number,\n",
        "  COUNT(*)         AS stint_laps\n",
        "FROM fact_transaction_lap l\n",
        "JOIN dim_session s        ON l.session_sk = s.session_sk\n",
        "JOIN dim_team t           ON l.team_sk = t.team_sk\n",
        "JOIN dim_driver d         ON l.driver_sk = d.driver_sk\n",
        "JOIN dim_tyre_compound tc ON l.tyre_compound_sk = tc.tyre_compound_sk\n",
        "WHERE tc.is_slick\n",
        "AND l.stint_number IS NOT NULL\n",
        "GROUP BY ALL"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "formula_1_gold"
    },
    {
      "name": "1f8ef035",
      "displayName": "execution_losses",
      "queryLines": [
        "WITH clean_laps AS (\n",
        "  SELECT l.session_sk, l.driver_sk, l.lap_duration_ms\n",
        "  FROM fact_transaction_lap l\n",
        "  JOIN dim_lap_flags f     ON l.lap_flags_sk = f.lap_flags_sk\n",
        "  JOIN dim_track_status ts ON l.track_status_sk = ts.track_status_sk\n",
        "  WHERE NOT f.is_pit_in_lap\n",
        "    AND NOT f.is_pit_out_lap\n",
        "    AND NOT ts.is_neutralised\n",
        "    AND l.lap_number > 1\n",
        "    AND l.lap_duration_ms IS NOT NULL\n",
        "),\n",
        "pace AS (\n",
        "  SELECT\n",
        "    session_sk,\n",
        "    driver_sk,\n",
        "    percentile_approx(lap_duration_ms, 0.5) AS median_lap_ms\n",
        "  FROM clean_laps\n",
        "  GROUP BY session_sk, driver_sk\n",
        "  HAVING COUNT(*) >= 10\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT\n",
        "    p.session_sk,\n",
        "    p.driver_sk,\n",
        "    rc.team_sk,\n",
        "    RANK() OVER (PARTITION BY p.session_sk ORDER BY p.median_lap_ms)          AS pace_rank,\n",
        "    RANK() OVER (PARTITION BY p.session_sk ORDER BY rc.classified_position)   AS finish_rank\n",
        "  FROM pace p\n",
        "  JOIN v_race_classification_current rc\n",
        "    ON p.session_sk = rc.session_sk AND p.driver_sk = rc.driver_sk\n",
        "  WHERE rc.classified_position IS NOT NULL\n",
        ")\n",
        "SELECT\n",
        "  s.season,\n",
        "  s.circuit_name,\n",
        "  s.session_type,\n",
        "  t.team_name,\n",
        "  d.full_name AS driver,\n",
        "  r.pace_rank,\n",
        "  r.finish_rank,\n",
        "  r.finish_rank - r.pace_rank AS positions_lost\n",
        "FROM ranked r\n",
        "JOIN dim_session s ON r.session_sk = s.session_sk\n",
        "JOIN dim_team t    ON r.team_sk = t.team_sk\n",
        "JOIN dim_driver d  ON r.driver_sk = d.driver_sk"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "formula_1_gold"
    }
  ],
